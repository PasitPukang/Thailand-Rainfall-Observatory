Rainfall (mm) = SUM(mart_weather_daily[rainfall_mm])

Heavy rain days =
CALCULATE(
    COUNTROWS(mart_weather_daily),
    mart_weather_daily[rain_class] IN {"heavy", "very_heavy"}
)

Very heavy rain days =
CALCULATE(
    COUNTROWS(mart_weather_daily),
    mart_weather_daily[rain_class] = "very_heavy"
)

Average temperature (C) = AVERAGE(mart_weather_daily[average_temperature_c])

Maximum daily rain (mm) = MAX(mart_weather_daily[rainfall_mm])

Average annual heavy rain days =
AVERAGEX(
    VALUES('Date'[Year]),
    [Heavy rain days]
)

-- When all provinces are selected, report the mean across representative points.
-- With one province selected, these equal that point's total/count.
Rainfall per point (mm) =
DIVIDE([Rainfall (mm)], DISTINCTCOUNT(dim_province[province_id]))

Heavy Days per point =
DIVIDE([Heavy rain days], DISTINCTCOUNT(dim_province[province_id]))

Very Heavy Days per point =
DIVIDE([Very heavy rain days], DISTINCTCOUNT(dim_province[province_id]))

Average Humidity (%) = AVERAGE(mart_weather_daily[average_humidity_pct])

Average Daily Max Wind (km/h) = AVERAGE(mart_weather_daily[maximum_wind_kmh])
